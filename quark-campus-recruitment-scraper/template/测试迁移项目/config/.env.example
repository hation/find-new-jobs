# 项目环境变量配置
PROJECT_NAME="测试迁移项目"
PROJECT_TYPE="crawler"

# API配置（如果是API项目）
API_BASE_URL="https://api.example.com"
API_KEY="your_api_key_here"
API_SECRET="your_api_secret_here"

# 数据库配置（如果需要）
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="测试迁移项目"
DB_USER="postgres"
DB_PASSWORD="your_password"

# 日志配置
LOG_LEVEL="INFO"
LOG_DIR="./logs"

# 数据目录
DATA_DIR="./data"
RAW_DATA_DIR="${DATA_DIR}/raw"
PROCESSED_DATA_DIR="${DATA_DIR}/processed"
